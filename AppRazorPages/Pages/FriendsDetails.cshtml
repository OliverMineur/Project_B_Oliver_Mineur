@page
@model MyApp.Namespace.FriendsDetailsModel
@{
}

<div class="ContentBox text-light">
    <div class="text-center">
        <h1 class="display-4">Friend Details</h1>
        <h5>Enter Friend Guid To See Details:</h5>
        <form method="post">
            <input type="text" name="FriendGuid" class="form-control" style="width: 400px; margin: auto"/>
            <button type="submit" asp-page-handler="CallFriendDetails" class="buttonColor text-light rounded mt-2">
                Submit
            </button>
        </form>

        @if (Model.FriendsData != null)
        {
            <div class="mt-4">
                <h3>Friend Information:</h3>
                <p><strong>Name:</strong> @Model.FriendDetails.FirstName @Model.FriendDetails.LastName</p>
                <p><strong>Birthday:</strong> @Model.FriendDetails.Birthday?.ToString("d-M-yyyy")</p>
                <p><strong>Email:</strong> @Model.FriendDetails.Email</p>
                <p><strong>Address:</strong> @Model.FriendDetails.Address?.StreetAddress, @Model.FriendDetails.Address?.City, @Model.FriendDetails.Address?.Country</p>

                @if (Model.FriendDetails.Pets != null && Model.FriendDetails.Pets.Any())
                {
                    <h4 class="mt-3">Pets:</h4>
                    foreach (var pet in Model.FriendDetails.Pets)
                    {
                        <p>- @pet.Name (@pet.Kind.ToString())</p>
                    }
                }
            </div>
        }
    </div>
</div>
