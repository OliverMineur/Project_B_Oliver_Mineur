@page
@model MyApp.Namespace.EditFriendModel
@{
}

<div class="ContentBox text-light">
    <div class="text-center">
        <h1 class="display-4">Edit Friend Details</h1>
        <h5>Enter Friend Guid To Edit Details:</h5>
        <form method="post">
            <input type="text" name="FriendGuid" class="form-control" style="width: 400px; margin: auto"/>
            <button type="submit" asp-page-handler="CallGetFriend" class="buttonColor text-light rounded mt-2">
                Submit
            </button>
        </form>

        @if (Model.FriendsData != null)
        {
            <div class="mt-4">
                <h3>Friend Information:</h3>

                <form method="post" class="mt-4" style="width: 400px; margin: auto">
                    <input type="text" hidden name="FriendGuid" value="@Model.FriendDetails.FriendId"/>
                    <div class="form-group">
                        <label for="FirstName">First Name:</label>
                        <input type="text" class="form-control" id="FirstName" name="FirstName" value="@Model.FriendDetails.FirstName"/>
                    </div>
                    <div class="form-group">
                        <label for="LastName">Last Name:</label>
                        <input type="text" class="form-control" id="LastName" name="LastName" value="@Model.FriendDetails.LastName"/>
                    </div>
                    <div class="form-group">
                        <label for="Birthday">Birthday:</label>
                        <input type="date" class="form-control" id="Birthday" name="Birthday" value="@Model.FriendDetails.Birthday?.ToString("yyyy-MM-dd")"/>
                    </div>
                    <div class="form-group">
                        <label for="Email">Email:</label>
                        <input type="email" class="form-control" id="Email" name="Email" value="@Model.FriendDetails.Email"/>
                    </div>
                    <button type="submit" asp-page-handler="CallEditFriend" class="buttonColor text-light rounded mt-2">
                        Submit
                    </button>
                </form>
                @if (Model.ShowSuccessMessage)
                {
                    <h3 class="text-success mt-3">Friend details updated successfully!</h3>
                }
            </div>
        }
    </div>
</div>