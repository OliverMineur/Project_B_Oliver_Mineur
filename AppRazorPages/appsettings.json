{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ApplicationSettings": {
    "AppName": "GoodFriends - Razor Pages UI",
    "Version": "1.0.0"
  },

  "ApplicationSecrets": {
    "SecretStorage": "UserSecrets"
  },

  "DatabaseConnections": {
    "DefaultDataUser": "dbo",    //"gstusr" | "usr" | "supusr" | "dbo" | "root"
    "MigrationUser": "root",    //migration is done by root user
    "UseDataSetWithTag": "sql-friends.sqlserver.docker" //"sql-friends.sqlserver.docker" | "sql-friends.mysql.docker" | "sql-friends.postgresql.docker"
  }

}
